# =============================================================================
# CGCPT Server Environment Configuration
# Copy this file to .env and fill in the actual values
# =============================================================================

# --- Database ---
# MySQL connection string (required)
# Format: mysql+pymysql://user:password@host:port/database?charset=utf8mb4
CGCPT_DB_URL=mysql+pymysql://cgcpt:changeme@localhost:3306/cgcpt?charset=utf8mb4

# --- Server ---
CGCPT_HOST=0.0.0.0
CGCPT_PORT=5000

# --- Debug ---
# Set to "true" to enable Flask debug mode (DO NOT use in production)
CGCPT_DEBUG=false

# --- Security ---
# Secret key for session signing and CSRF protection (CHANGE THIS IN PRODUCTION)
CGCPT_SECRET_KEY=change-me-to-a-random-secret-string

# --- Admin Credentials ---
# Default admin account (IMPORTANT: change these before deployment)
CGCPT_ADMIN_USER=admin
CGCPT_ADMIN_PASS=changeme

# --- CORS ---
# Comma-separated list of allowed origins, or "*" for all
CGCPT_CORS_ORIGINS=http://localhost:3000,http://localhost:5000

# --- Logging ---
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
CGCPT_LOG_LEVEL=INFO

# --- File Paths ---
# Directory for uploaded files
CGCPT_UPLOAD_DIR=./uploads

# Directory for trained ML models
CGCPT_MODEL_DIR=./models

# Directory for database JSON and CIF files
CGCPT_DATABASE_DIR=./database
